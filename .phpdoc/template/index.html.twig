{% extends 'base.html.twig' %}

{% block content %}
    <section>
        <h2>Welcome to the Susina Configuration Builder documentation site!</h2>
        <p>
            <img src="https://github.com/susina/config-builder/actions/workflows/test.yml/badge.svg" alt="Test Status" />
            <img src="https://img.shields.io/github/license/susina/config-builder" alt="License" />
            <a href="https://qlty.sh/gh/susina/projects/config-builder"><img src="https://qlty.sh/gh/susina/projects/config-builder/maintainability.svg" alt="Maintainability" /></a>
            <a href="https://qlty.sh/gh/susina/projects/config-builder"><img src="https://qlty.sh/gh/susina/projects/config-builder/coverage.svg" alt="Code Coverage" /></a>
